# Textile Shop Management System - Environment Configuration Template
NODE_ENV=development
APP_NAME="Textile Shop Management System"
APP_VERSION=1.0.0
APP_PORT=5173

# Database Configuration
DB_NAME=textile-shop.db
DB_BUSY_TIMEOUT=5000
DB_CACHE_SIZE_MB=64

# Backup & Retention
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
AUTO_BACKUP_ENABLED=true

# Security & Rate Limiting
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_COOLDOWN_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=60

# Logging
LOG_LEVEL=info
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=5
