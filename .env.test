NODE_ENV=test
APP_NAME="Textile Shop Management System (Test)"
APP_VERSION=1.0.0
DB_NAME=textile-shop-test.db
DB_BUSY_TIMEOUT=5000
DB_CACHE_SIZE_MB=32
BACKUP_RETENTION_DAILY=3
BACKUP_RETENTION_WEEKLY=1
AUTO_BACKUP_ENABLED=false
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_COOLDOWN_MINUTES=1
SESSION_IDLE_TIMEOUT_MINUTES=30
LOG_LEVEL=error
LOG_MAX_SIZE_MB=5
LOG_MAX_FILES=2
